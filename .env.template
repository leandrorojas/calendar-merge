# iCloud credentials
ICLOUD_USERNAME=""
ICLOUD_PASSWORD=""
# Setting this switches the merge to CalDAV, which accepts an app-specific
# password. The web API that pyicloud uses accepts only the account password,
# so this is the way in when Apple restricts password sign-in.
# Generate one at appleid.apple.com -> Sign-In and Security. Leave it empty to
# keep using pyicloud and its 2FA flow.
ICLOUD_APP_PASSWORD=""

# Calendar ICS feed URLs. Indexes start at 0 and must be consecutive, each
# matching a source-calendar-<index> section in config.yaml.
#
# Outlook / Microsoft 365: publish the calendar in Outlook on the web
# (Settings -> Calendar -> Shared calendars) and copy the ICS link, e.g.
# https://outlook.office365.com/owa/calendar/<id>@<domain>/<token>/calendar.ics
#
# These links are unauthenticated secrets: anyone holding one can read the
# calendar. Keep them here (this file is gitignored) and never commit them.
CALENDAR_URL_0=""
CALENDAR_URL_1=""

# Telegram (optional; required for alerts and for 2FA code entry)
TELEGRAM_BOT_API_TOKEN=""
TELEGRAM_CHAT_ID=""

# Logging (optional)
# CALENDAR_MERGE_LOG_FILE="logs/calendar-merge.log"
# CALENDAR_MERGE_LOG_LEVEL="INFO"
