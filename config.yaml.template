config:
  # Default skipped weekdays for every source. 0=Monday ... 6=Sunday.
  # A source-calendar-N block can override this with its own skip_days.
  skip_days: 5, 6
  # Global: how many non-skipped days ahead to sync. Not overridable per source,
  # and it is counted using the global skip_days above.
  future_events_days: 5
  # The iCloud calendar the merge writes into, matched on its display name
  # exactly. Leave it out to keep the old behaviour of using whichever calendar
  # the provider returns first -- fine with one calendar, arbitrary with several,
  # and not necessarily the same one across backends.
  destination_calendar: "Personal"
  # After the first failure alert, how many further failed runs before it repeats.
  # Runs hold no state between them, so without this a single outage alerts once per
  # run. 0 alerts only on the first failure and on recovery.
  failure_alert_every: 4

# One block per source calendar. Indexes must start at 0 and be consecutive,
# and each block needs a matching CALENDAR_URL_<index> entry in .env.
#
#   source:    short name of the upstream calendar (e.g. Google, Outlook)
#   tag:       shown in brackets in the generated iCloud event title
#   title:     your friendly name for the merged events
#   tz:        IANA timezone used when writing events into iCloud
#   skip_days: optional; overrides config.skip_days for this calendar only.
#              Use an empty value to sync every day.

source-calendar-0:
  source: "Google"
  tag: "WRK"
  title: "Team Calendar"
  tz: "America/New_York"

# Outlook / Microsoft 365 feeds are plain ICS and need no special settings.
# Publish the calendar in Outlook on the web and copy the .ics link into
# CALENDAR_URL_1 in .env -- that link is a secret, so keep it out of this file.
source-calendar-1:
  source: "Outlook"
  tag: "OUT"
  title: "Work Calendar"
  tz: "America/Argentina/Buenos_Aires"
  # Overrides config.skip_days: this calendar syncs Saturdays too.
  # A single day needs no quotes or brackets. Use "" to sync every day.
  skip_days: 6
